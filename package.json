{
  "name": "nuus-portfolio",
  "type": "module",
  "version": "4.1.1",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro check && astro build && pagefind --site dist/client && cp -r dist/client/pagefind public/",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy -e production",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "concurrently": "^10.0.7",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "minimatch": "10.2.6",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@pagefind/default-ui": "^1.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.159.0"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.24.0",
      "fast-xml-parser": ">=5.5.7"
    }
  }
}
